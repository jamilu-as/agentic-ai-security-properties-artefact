# PDFs are excluded by default, then allowed back under sources/.
# This repository is PRIVATE. The module handbook says its materials must not be
# shared or uploaded to websites; keeping them under sources/university/ in a
# private repo is a deliberate decision by the author. If this repo is ever made
# public, sources/university/ must be removed first.
*.pdf
!sources/*.pdf
!sources/university/*.pdf
!sources/*.md

# Submitted work kept local (Turnitin / originality)
*.docx
~$*

# Secrets and environment
.env
.env.*
secrets/
*.key

# Run outputs: manifests are committed, raw model outputs are not
# (proposal §4.6: "raw model outputs withheld to prevent prompt extraction reverse-engineering")
results/raw/
results/**/*.jsonl
*.ckpt
*.safetensors

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# OS
.DS_Store

# Live API credentials. Added 29 Aug 2026: `.env` was covered but a plain
# tokens.txt was not, and it held working HuggingFace, RunPod and OpenRouter keys.
# It had never been committed; nothing but luck was stopping `git add -A`.
tokens.txt
*.token
*.pem

# Harness run outputs. Manifests ARE committed - §3.10 requires them - but the
# trajectory logs under them are raw model output and are withheld.
work/w2-composition/results/runs/logs/
work/w2-composition/results/runs/**/*.json
!work/w2-composition/results/runs/*.json

# University-provided materials — the MSG states these must not be uploaded to
# websites. This is the handbook and both marking-criteria sheets.
*.pdf

# The student's OWN submitted work is extracted to sources/*.md and versioned:
# it is the foundation the dissertation is built on, and it needs to be readable
# by the checks. The PDFs themselves stay local.
!sources/*.md

# Submitted work kept local (Turnitin / originality)
*.docx
~$*

# Secrets and environment
.env
.env.*
secrets/
*.key

# Run outputs: manifests are committed, raw model outputs are not
# (proposal §4.6: "raw model outputs withheld to prevent prompt extraction reverse-engineering")
results/raw/
results/**/*.jsonl
*.ckpt
*.safetensors

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# OS
.DS_Store
